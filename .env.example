# Clave de la Anthropic API para el análisis con Claude vision
ANTHROPIC_API_KEY=sk-ant-...

# Modelo Claude a usar para análisis (default: claude-sonnet-4-6)
MAE_CLAUDE_MODEL=claude-sonnet-4-6

# País por defecto (ISO-2) para Ad Library
MAE_COUNTRY=AR

# Ruta de la base SQLite (default: ./meta_ads.db)
MAE_DB_PATH=./meta_ads.db

# Carpeta donde guardar creatividades descargadas
MAE_CREATIVES_DIR=./creatives

# Modo headless del browser (true/false)
MAE_HEADLESS=true

# Delay entre scrolls al cargar resultados (segundos)
MAE_SCROLL_DELAY=1.8
